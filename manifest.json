{
  "manifest_version": 3,
  "name": "Google Account Switcher",
  "version": "1.1.1",
  "description": "Secara otomatis mengarahkan link Google Workspace (Drive, Docs, dll) & Gemini ke akun yang Anda tentukan.",
  "permissions": [
    "storage",
    "webNavigation",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.google.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/images/default_avatar.png"],
      "matches": ["*://*.google.com/*"]
    }
  ],
  "action": {
    "default_popup": "src/html/popup.html",
    "default_icon": "assets/images/icon.png"
  },
  "icons": {
    "16": "assets/images/icon.png",
    "32": "assets/images/icon.png",
    "48": "assets/images/icon.png",
    "128": "assets/images/icon.png"
  },
  "background": {
    "service_worker": "src/js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.google.com/*"],
      "js": ["src/js/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
